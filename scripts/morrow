#!/bin/zsh
# One command for the local beta. :A follows the installed command's symlink.
set -eu
morrow_root=${0:A:h:h}
if [[ -x "$morrow_root/venv/bin/python" ]]; then
  morrow_python="$morrow_root/venv/bin/python"
else
  morrow_python=$(command -v python3) || { print -u2 'Python 3 is required to run Morrow.'; exit 1; }
fi
exec "$morrow_python" "$morrow_root/scripts/morrow_launcher.py" "$@"

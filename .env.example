# Naukri Auto-Apply Bot Configuration
# Copy this file to .env and fill in your details
# NEVER commit .env to git (it's in .gitignore)

# =====================================================================
# CREDENTIALS (used by both the legacy scripts and naukri_bot)
# =====================================================================

NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password


# =====================================================================
# naukri_bot (v2) - run with:  python3 -m naukri_bot
# =====================================================================

# Your facts file. Copy common/profile.example.yaml to data/inputs/profile.yaml and
# fill it in. Anything you leave blank there is a fact the bot does NOT know,
# and it will skip any application that asks about it rather than guess.
PROFILE_PATH=data/inputs/profile.yaml

# Your resume. The LaTeX source is the one to point at: it is used for relevance
# ranking, compiled to the PDF that goes on your profile, and tailored per job
# (see the Resume block further down). Plain text and .md also work for ranking only.
RESUME_PATH=data/resume/base.tex

# SQLite store: which jobs you have already applied to, and the rolling
# 24h quota ledger. Delete this and the bot loses its memory - it will
# re-apply to jobs and mis-count your quota. Back it up, don't clear it.
DB_PATH=data/db/naukri_bot.db

# Naukri's hard cap on applications per day.
DAILY_QUOTA=50

# How many to actually use this morning. Keep <= DAILY_QUOTA. The bot also
# subtracts whatever it already spent in the last 24h, so running twice in
# one day will not double-spend.
TARGET_APPLICATIONS=50

# Size of the candidate pool to collect before ranking. Bigger pool, better
# top-50, slower run. 400 takes roughly 6-10 minutes to collect.
MAX_CANDIDATES=400

# How many of the top lexically-scored candidates get sent to the LLM for
# scoring. Jobs past this cut are never ranked and never applied to, so keep it
# at least MAX_CANDIDATES unless the run is too slow.
LLM_RANK_TOP_N=400
# Ranking calls run side by side (each call scores LLM_RANK_BATCH_SIZE jobs).
LLM_RANK_WORKERS=3

# Relevance floor (0-100). Jobs scoring below this are never applied to,
# even if that means using fewer than TARGET_APPLICATIONS. Raise it if you
# are getting irrelevant matches; lower it if the bot applies to too few.
MIN_SCORE=55

# Ignore postings older than this many days. Jobs with no readable date are
# kept (unknown age is not treated as old).
MAX_DAYS_OLD=7

# Search keywords (comma-separated). Leave EMPTY to derive them from your
# resume titles and skills automatically - that is the intended mode.
KEYWORDS=

# Location filter. Leave empty to search all locations.
LOCATION=

# Search result pages to scrape per keyword.
PAGES_PER_KEYWORD=3

# Years of experience to filter searches by, so Naukri only returns jobs whose
# range covers it. Measured on 8 October: the unfiltered endpoint returned 13 of
# 20 cards covering 3 years, the filtered one 20 of 20, for the same page load.
# Only Naukri's slug landing pages honour the filter, so a keyword Naukri has no
# landing page for falls back to the unfiltered endpoint rather than returning
# nothing. 0 disables it.
SEARCH_EXPERIENCE_YEARS=0

# Run without a visible browser window. Naukri is more likely to challenge
# headless sessions, and you cannot solve a captcha you cannot see.
HEADLESS=false
# Compatibility setting: BACKGROUND=true also runs without a desktop window.
# It no longer moves a visible browser off-screen. For manual sign-in, set both
# HEADLESS=false and BACKGROUND=false. Dashboard browser mode overrides these
# settings for that run; its default is Background.
BACKGROUND=false

# Collect and rank, print the plan, then stop before the first click.
# Always do one dry run after changing your profile or keywords.
DRY_RUN=false

# LLM backend for screening answers and relevance scoring:
#   claude-cli  - shells out to the `claude` CLI (no API key needed)
#   anthropic   - uses the anthropic SDK, needs ANTHROPIC_API_KEY
#   none        - no LLM: lexical ranking only, and every non-cached
#                 screening question causes the application to be skipped
LLM_BACKEND=claude-cli

# Leave empty for the backend's default model.
LLM_MODEL=

# Per-call LLM timeout in seconds.
LLM_TIMEOUT_S=90

# How screening questions are handled:
#   auto    - submit answers that are grounded in your facts file
#   propose - log what it WOULD submit, then skip. Use this for the first
#             few runs to see what the bot would say on your behalf.
#   ask     - only use cached/known-fact answers, never the LLM
ANSWER_MODE=auto

# In auto mode, a question your facts do not answer gets a second look before
# the job is skipped: 0 years for a skill your resume never names, N/A for a
# follow-up whose premise is false, "Other" when the list lacks your value.
# Every judged answer is written to data/inputs/answers.txt with the reason; edit it
# and your answer wins. Gender, visa, salary-type guesses are never made.
# The same switch lets a required long answer on a company-site form ("Why
# this role?") be written from your resume and the posting; each one is kept
# in data/resume/out/tailored/<Company - Role>/answers.md for you to read.
JUDGE_ANSWERS=true


# ---------------------------------------------------------------------
# Profile updater:  python3 -m naukri_bot.update_profile
# Keeps the profile "recently updated" by toggling a trailing "." on the
# resume headline three times a day. Uses none of the apply quota. The
# credentials and HEADLESS above apply to it too; DRY_RUN does not (use
# its --dry-run flag). See README.
# ---------------------------------------------------------------------

# Memory of which daily slots (09:00, 13:30, 18:30) already ran, so a laptop
# that slept through a slot catches up once rather than once per slot.
PROFILE_UPDATE_STATE_PATH=data/logs/profile_update.json

# Where a screenshot of the page goes when an update fails.
SCREENSHOT_DIR=data/screenshots

# Random wait, in seconds, before a scheduled run starts, so the three daily
# updates do not land on the exact slot minute. scripts/run_profile_update.sh
# sets 600 for launchd runs; 0 here keeps manual runs immediate.
MAX_START_DELAY_SECONDS=0

# Optional Telegram bot for a message when an update fails after all retries.
# Leave both empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Resume: compiled from the LaTeX source at RESUME_PATH ---------------------
# Needs a LaTeX compiler on PATH (brew install tectonic). Compiled and tailored
# PDFs land under RESUME_OUT_DIR; python3 -m common.resume compiles the base.
RESUME_OUT_DIR=data/resume/out

# File name recruiters see. Empty derives First_Last_Resume.pdf from the name
# in the resume header.
RESUME_FILE_NAME=

# tectonic | pdflatex | xelatex. Empty picks the first one found.
TEX_COMPILER=

# Before each real application, reorder the Skills, reword the subtitle and
# Summary toward the posting (never adding anything the resume does not say),
# compile, and upload that PDF to the profile. The base PDF is restored at the
# end of the run. Costs one LLM call and one upload per application.
TAILOR_RESUME=false

# Let the profile updater re-upload the base PDF once a day, and whenever the
# compiled PDF changed because you edited data/resume/base.tex.
UPLOAD_RESUME_DAILY=false

# --- Your data folder: facts, answers, company-site worklist ------------------
# data/inputs/answers.txt holds your own answers (Q: / A: lines) and is checked before
# anything else; questions the bot could not answer are appended there with an
# empty A: for you to fill. data/inputs/company_sites.md lists company-site
# applications that need you.
DATA_DIR=data/inputs

# --- Company websites ("Apply on company site") --------------------------------
# Follow the button, fill the employer's form from your facts, answers and the
# (tailored) resume, and submit only when every required field is answered and
# the site confirms. Anything less goes to data/inputs/company_sites.md. Sites that
# want their own account get one (see COMPANY_SITE_EMAIL below).
EXTERNAL_APPLY=false
# Company sites tried per run (each takes a few minutes).
EXTERNAL_APPLY_LIMIT=15
# The Google account to pick when a site offers "Sign in with Google". Each run
# with EXTERNAL_APPLY signs the bot's browser in to it first: the email is typed,
# then GOOGLE_PASSWORD when set (optional). A passkey, phone prompt or code is
# left to you: the run waits 2 minutes for it, then goes on with email sign-in.
# Or sign in once yourself: python3 -m sites_bot.external --google-login
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# Career sites that want their own account (Workday, iCIMS, ...) get this email
# (empty: GOOGLE_EMAIL, then NAUKRI_EMAIL) and password. Leave the password
# empty and the bot generates a strong one the first time and writes it here.
# data/inputs/accounts.md lists every site it signed in to or registered on.
COMPANY_SITE_EMAIL=
COMPANY_SITE_PASSWORD=
# When the scripted filler stops short on a company site, Claude Code (your
# local `claude` login) takes over the same Chrome window through a Playwright
# MCP server and works the form from your facts. It stops at captchas, emailed
# codes and questions your facts do not answer; its "submitted" counts only
# when the confirmation it quotes is on the page. Needs Node (npx) and claude.
BROWSER_AGENT=false
# Tasks per run, seconds and dollars per task, and an optional model alias
# (empty: claude's default).
BROWSER_AGENT_LIMIT=5
BROWSER_AGENT_TIMEOUT_S=900
BROWSER_AGENT_BUDGET_USD=5
BROWSER_AGENT_MODEL=
# The MCP server command; the version is pinned so a run never waits on a download.
BROWSER_AGENT_MCP=npx -y @playwright/mcp@0.0.83

# --- Other job boards:  python3 -m sites_bot.platforms --------------------------
# Hirist, Instahyre: same facts, answers, ranking and records as Naukri. Sign in
# to each board once in the bot's browser: scripts/google_login.sh <board URL>.
PLATFORMS=hirist,instahyre
# Applications per board per run.
PLATFORM_LIMIT=10

# --- Cold emails:  python3 -m sites_bot.cold_email ------------------------------
# Drafts only, never sent: an .eml file per email under data/reports/<date>/emails/,
# and a Gmail draft too when GMAIL_APP_PASSWORD is set (Google account > Security
# > 2-Step Verification > App passwords). Addresses come only from postings and
# career pages that published them.
COLD_EMAIL_FROM=
GMAIL_APP_PASSWORD=
COLD_EMAIL_LIMIT=10

# --- Daily report ----------------------------------------------------------------
# data/reports/<YYYY-MM-DD>/report.md: what was applied to, what is left for you,
# profile refreshes, LinkedIn, and today's study module.
REPORT_DIR=data/reports
# The study site whose 8-week plan the report follows, one module a day.
COURSE_DIR=course
# YYYY-MM-DD the plan started. Empty: the day the first report was written.
COURSE_START_DATE=


# =====================================================================
# LEGACY (legacy/Naukri-Edge.py / legacy/Naukri-Recommended.py only)
# naukri_bot ignores everything below except PAGES_PER_KEYWORD above.
# =====================================================================

# Used for the custom first/last name fields on some legacy application forms
FIRSTNAME=YourFirstName
LASTNAME=YourLastName

# Legacy cap. naukri_bot uses TARGET_APPLICATIONS + DAILY_QUOTA instead.
MAX_APPLICATIONS=50

# Only needed if NOT using webdriver-manager auto-detection
# EDGE_DRIVER_PATH=C:\path\to\msedgedriver.exe
# FIREFOX_PROFILE_PATH=C:\path\to\firefox\profile

# =====================================================================
# linkedin_bot - run with: python3 -m linkedin_bot --dry-run
# One post a day in your own words about a fresh article on your topics.
# Shares HEADLESS, LLM_BACKEND and TELEGRAM_* with naukri_bot.
# =====================================================================

# Only needed for --post and for --if-due with LINKEDIN_AUTO_POST=true.
# --dry-run and --propose work without them.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Comma-separated. Articles are scored by how many of these they mention.
LINKEDIN_TOPICS=AI agent evaluation,LLM benchmarks,multi-agent systems,LangChain,Next.js

# Comma-separated RSS/Atom URLs. Empty uses Hacker News search per topic plus
# TechCrunch AI, The Verge AI, Ars Technica AI, MIT Technology Review AI,
# the Hugging Face blog and Simon Willison's feed.
LINKEDIN_FEEDS=

# Local time after which the daily run is due (launchd checks every 30 min).
LINKEDIN_POST_TIME=09:30

# false: the daily run only writes data/linkedin/drafts/<date>.md (and sends it on
# Telegram) for you to read and post. true: it publishes without asking.
LINKEDIN_AUTO_POST=false

# true: each post also gets a swipeable PDF carousel (cover, 4-7 slides, a closing
# question), uploaded as a LinkedIn document. If the upload fails before Post is
# clicked, the image card is posted instead.
LINKEDIN_CAROUSEL=true

# Who writes the post: claude or kiro (local CLI, no API key), or backend
# (whatever LLM_BACKEND is set to).
LINKEDIN_WRITER=claude

# Who reads the full article on the web first and hands the writer notes:
# claude, kiro or none.
LINKEDIN_RESEARCH=claude

# Who reviews the draft once and sends fixes back: claude, kiro or none.
LINKEDIN_CRITIC=kiro

# Who designs the image card as HTML, drawn to PNG by local headless Chrome:
# claude or kiro. card skips it and always draws the plain Pillow card, which
# is also the fallback when the design fails.
LINKEDIN_IMAGE=claude

# Seconds each research, writing, review or design call may take.
LINKEDIN_AI_TIMEOUT_S=600

# Chrome binary for the designed card. Empty finds Google Chrome or Chromium.
# LINKEDIN_CHROME=

# Ignore articles older than this many days.
LINKEDIN_MAX_AGE_DAYS=3

# Where posted URLs and the per-day attempt record live.
LINKEDIN_STATE_PATH=data/linkedin/state.json

# Where drafts and their image cards are written.
LINKEDIN_DRAFT_DIR=data/linkedin/drafts

# Each post gets its own folder here, <topic>/<date>/, holding card.png,
# post.txt, carousel.pdf, card.html and article.txt.
LINKEDIN_POST_DIR=data/linkedin_post

# Separate Chrome profile that keeps the LinkedIn session. Must not be the
# Naukri profile.
LINKEDIN_BROWSER_PROFILE_DIR=data/browser/linkedin

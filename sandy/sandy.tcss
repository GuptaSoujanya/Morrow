/* Sandy: one screen for the job bots and the study site. */

#pills {
    height: 3;
    padding: 1 1 0 1;
    background: $panel;
}

.pill {
    width: auto;
    height: 1;
    margin-right: 1;
    padding: 0 2;
    background: $boost;
    color: $text-muted;
}
.pill.ok { background: $success 20%; color: $text-success; text-style: bold; }
.pill.warn { background: $warning 20%; color: $text-warning; text-style: bold; }
.pill.busy { background: $accent 25%; color: $text-accent; text-style: bold; }

#body { height: 1fr; }

#nav {
    width: 24;
    height: 100%;
    border: none;
    border-right: tall $panel-lighten-1;
    background: $panel;
    padding: 1 0;
}
#nav:focus { border-right: tall $accent; }
#nav > .option-list--option { padding: 0 1; }

#main { width: 1fr; }
#panels { height: 1fr; }

.panel { padding: 1 3 0 3; scrollbar-size-vertical: 1; }

.title {
    text-style: bold;
    color: $text-accent;
    height: auto;
}
.about {
    color: $text-muted;
    margin-bottom: 1;
    height: auto;
}
.section {
    text-style: bold;
    color: $text-primary;
    margin-top: 1;
    height: auto;
}
.hint {
    color: $text-muted;
    margin-top: 1;
    height: auto;
}

.card {
    border: round $primary 40%;
    padding: 0 1;
    margin-top: 1;
    height: auto;
}
#today-summary {
    border: round $accent 50%;
    padding: 1 2;
    margin-top: 0;
}

.field { height: auto; margin-top: 1; }
.field-label {
    width: 20;
    padding: 1 1 0 0;
    color: $text-muted;
}
.field-label.wide { width: auto; padding: 0; margin-top: 1; }
.field Input, .field Select { width: 1fr; }

.toggle { height: auto; }
.toggle Switch { width: auto; border: none; padding: 0 1; height: 1; margin: 1 0 0 0; }
.toggle .toggle-label { padding: 1 0 0 1; color: $foreground; }

#rs-jd-text { height: 10; margin-top: 1; }

.preview {
    margin-top: 1;
    padding: 0 1;
    background: $boost;
    color: $text-muted;
    height: auto;
}

.buttons { height: auto; margin-top: 1; }
.buttons Button { margin-right: 2; }

#quick {
    grid-size: 3;
    grid-gutter: 1 2;
    grid-rows: 3;
    height: auto;
    margin-top: 1;
}
#quick Button { width: 100%; }

#output {
    height: 38%;
    min-height: 8;
    border: round $primary 60%;
    border-title-color: $text-accent;
    border-title-style: bold;
    border-subtitle-color: $text-warning;
}
#log { background: $surface; padding: 0 1; scrollbar-size-vertical: 1; }

#main.output-only #panels { display: none; }
#main.output-only #output { height: 1fr; }
#main.reading #output { display: none; }
#main.reading.output-only #output { display: block; }

#editor-title, #reader-title, #study-title {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-accent;
}
#editor { height: 1fr; border: none; }
#reader, #study-reader { height: 1fr; }

#study-today { border: round $accent 50%; padding: 1 2; }
#course-tree {
    height: auto;
    max-height: 24;
    margin-top: 1;
    padding: 0 1;
    border: round $primary 40%;
    scrollbar-size-vertical: 1;
}
#course-tree:focus { border: round $accent; }

ConfirmScreen { align: center middle; background: $background 60%; }
#confirm {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $error 60%;
    background: $surface;
}
#confirm-text { height: auto; margin-bottom: 1; }
#confirm-buttons { height: auto; align-horizontal: right; }
#confirm-buttons Button { margin-left: 2; }
